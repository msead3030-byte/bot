# Required: keep these values secret and set them in Railway Variables, never in Git.
M_AUTOMATION_BOT_TOKEN=replace-with-telegram-bot-token
M_AUTOMATION_SUPER_ADMIN_IDS=123456789
M_AUTOMATION_DATA_KEY=replace-with-a-random-64-character-hex-key

# Store branding
STORE_BRAND_NAME=M-Automation Store
STORE_CURRENCY_CODE=EGP
STORE_CURRENCY_NAME=Egyptian pound

# Database
# Local development only: uncomment to override the default local runtime/store.db path.
# M_AUTOMATION_DB_PATH=runtime/store.db
# Railway: do not set M_AUTOMATION_DB_PATH. Attach a Volume; the app automatically uses
# RAILWAY_VOLUME_MOUNT_PATH/store.db at runtime.

# Manual wallet top-ups. Keep disabled until both receiver values are filled in.
MANUAL_TOPUPS_ENABLED=false
MANUAL_WALLET_RECEIVER=
MANUAL_WALLET_INSTRUCTIONS=Transfer the exact amount, then send the receipt image to this bot.
MANUAL_BINANCE_RECEIVER=
MANUAL_BINANCE_INSTRUCTIONS=Transfer the exact amount, then send the receipt image to this bot.

# Automatic Wallet Top-ups via SMS Webhook (Vodafone Cash / InstaPay / Wallets)
AUTO_TOPUP_ENABLED=true
AUTO_TOPUP_WALLET_RECEIVER=01000000000
SMS_WEBHOOK_PORT=3000
SMS_WEBHOOK_SECRET=your_secret_webhook_token
AUTO_TOPUP_EXPIRY_MINUTES=30

# Admin contact details (Telegram account link or username for direct redirect)
ADMIN_CONTACT_URL=https://t.me/your_admin_username
ADMIN_USERNAME=your_admin_username

# Manual top-up receiver numbers / IDs
MANUAL_WALLET_RECEIVER=01000000000
MANUAL_BINANCE_RECEIVER=123456789

# 4 Mandatory Channels / Groups join check (optional)
# Leave empty if you don't want to enforce subscription; the bot will work normally.
REQUIRED_CHANNEL_1=
REQUIRED_CHANNEL_1_LINK=https://t.me/your_channel_1
REQUIRED_CHANNEL_2=
REQUIRED_CHANNEL_2_LINK=https://t.me/your_channel_2
REQUIRED_GROUP_1=
REQUIRED_GROUP_1_LINK=https://t.me/your_group_1
REQUIRED_GROUP_2=
REQUIRED_GROUP_2_LINK=https://t.me/your_group_2

# Telegram networking
TELEGRAM_POLL_TIMEOUT=25
TG_REQUEST_TIMEOUT_MS=10000
TG_MIN_PER_CHAT_GAP_MS=200
TG_REQUEST_MAX_ATTEMPTS=3
TG_FILE_UPLOAD_TIMEOUT_MS=120000


