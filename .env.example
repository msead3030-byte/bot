# ==============================================================================
# 🔐 1. المتغيرات الأساسية الإلزامية (CORE CREDENTIALS - REQUIRED)
# ==============================================================================
# توكن البوت الذي حصلت عليه من @BotFather
M_AUTOMATION_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# الآيدي الخاص بك على تليجرام (يمكن وضع أكثر من آيدي مفصولين بفواصل: 111111,222222)
# للحصول على آيديك راسل بوت @userinfobot
M_AUTOMATION_SUPER_ADMIN_IDS=123456789

# مفتاح تشفير البيانات والمخزون الحساس (AES-256-GCM) مكون من 64 خانة Hex
# احتفظ به سراً ولا تغيره بعد تشغيل البوت لتجنب فقدان القدرة على فك تشفير المخزون القديم
M_AUTOMATION_DATA_KEY=d1f2e3a4b5c6d7e8f90123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# ⚡ 2. نظام الشحن الآلي عبر رسائل الـ SMS (فودافون كاش / إنستاباي / المحافظ)
# ==============================================================================
# تفعيل أو تعطيل الشحن التلقائي (true / false)
AUTO_TOPUP_ENABLED=true

# رقم محفظة فودافون كاش أو الحساب الذي يستقبل أموال العملاء
AUTO_TOPUP_WALLET_RECEIVER=01000000000

# منفذ خادم الويب هوك لاستقبال الرسائل (على السحابة مثل Railway يُترك 3000 أو يستخدم منفذ PORT المدمج)
SMS_WEBHOOK_PORT=3000

# كلمة سر تأمين الويب هوك (ضع أي كلمة سر قوية هنا، ثم ضعها في تطبيق تحويل الرسائل على الهاتف)
SMS_WEBHOOK_SECRET=MySuperSecretToken2026

# صلاحية العملية بالدقائق (يتم رفض أي تحويل تم إرساله قبل هذا الوقت لمنع استغلال رسائل قديمة)
AUTO_TOPUP_EXPIRY_MINUTES=30

# ==============================================================================
# 🏪 3. هوية المتجر والعملة (STORE BRANDING & CURRENCY)
# ==============================================================================
# اسم المتجر الذي يظهر في لوحة البوت والرسائل
STORE_BRAND_NAME=Mohamed Store

# رمز العملة واسمها
STORE_CURRENCY_CODE=EGP
STORE_CURRENCY_NAME=جنيه مصري

# ==============================================================================
# 💬 4. بيانات الدعم والتواصل مع الإدارة (ADMIN SUPPORT)
# ==============================================================================
# رابط أو يوزر حساب الأدمن للتواصل المباشر عند طلب الدعم
ADMIN_CONTACT_URL=https://t.me/your_admin_username
ADMIN_USERNAME=your_admin_username

# ==============================================================================
# 💳 5. الشحن اليدوي (MANUAL TOP-UP & BINANCE - اختياري)
# ==============================================================================
# تفعيل الشحن اليدوي مع مراجعة الإيصالات يدوياً (true / false)
MANUAL_TOPUPS_ENABLED=false

# رقم المحفظة للشحن اليدوي
MANUAL_WALLET_RECEIVER=01000000000
MANUAL_WALLET_INSTRUCTIONS=قم بتحويل المبلغ المطلوب ثم أرسل صورة الإيصال هنا.

# معرف باينانس للشحن بالعملات الرقمية (Binance Pay ID)
MANUAL_BINANCE_RECEIVER=123456789
MANUAL_BINANCE_INSTRUCTIONS=أرسل المبلغ المطلوب عبر Binance Pay وأرسل لقطة الشاشة هنا.

# ==============================================================================
# 🗄️ 6. قاعدة البيانات والاستضافة السحابية (DATABASE & CLOUD HOSTING)
# ==============================================================================
# على Railway: لا تعدل هذا المتغير، فقط قم بإنشاء Volume وربطه وسيتعرف البوت عليه تلقائياً
# على VPS عادي أو Docker: يمكنك تحديد مسار التخزين الدائم لقاعدة البيانات:
# M_AUTOMATION_DB_PATH=/data/store.db

# ==============================================================================
# 📢 7. التحقق من الاشتراك الإجباري بالقنوات والجروبات (اختياري)
# ==============================================================================
# اتركها فارغة إذا كنت لا تريد إجبار الأعضاء على الاشتراك
REQUIRED_CHANNEL_1=
REQUIRED_CHANNEL_1_LINK=https://t.me/
REQUIRED_CHANNEL_2=
REQUIRED_CHANNEL_2_LINK=https://t.me/
REQUIRED_GROUP_1=
REQUIRED_GROUP_1_LINK=https://t.me/
REQUIRED_GROUP_2=
REQUIRED_GROUP_2_LINK=https://t.me/

# ==============================================================================
# 🌐 8. إعدادات الشبكة والتليجرام (NETWORK & POLLING TIMEOUTS)
# ==============================================================================
TELEGRAM_POLL_TIMEOUT=25
TG_REQUEST_TIMEOUT_MS=10000
TG_MIN_PER_CHAT_GAP_MS=200
TG_REQUEST_MAX_ATTEMPTS=3
TG_FILE_UPLOAD_TIMEOUT_MS=120000
